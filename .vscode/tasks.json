{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Local Dev Server",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build Web App",
      "type": "shell",
      "command": "npm run build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "npm test",
      "group": "test"
    },
    {
      "label": "Sync Capacitor Android",
      "type": "shell",
      "command": "npx cap sync android",
      "problemMatcher": []
    },
    {
      "label": "Build Android Debug APK",
      "type": "shell",
      "command": "cd android && ./gradlew assembleDebug",
      "problemMatcher": [],
      "dependsOn": ["Build Web App", "Sync Capacitor Android"]
    }
  ]
}
